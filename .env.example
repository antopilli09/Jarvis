# Copia questo file in ".env" e inserisci i tuoi valori.

# Modello Ollama da usare (deve essere stato scaricato con: ollama pull <modello>)
OLLAMA_MODEL=qwen2.5:7b

# Il tuo nome (usato solo da backend/jarvis.py, la versione a riga di comando)
JARVIS_USER_NAME=

# Città per meteo e briefing
CITY_NAME=
LATITUDE=
LONGITUDE=
TIMEZONE=Europe/Rome

# Server. Con HOST=127.0.0.1 è raggiungibile solo dal tuo PC;
# con 0.0.0.0 anche dagli altri dispositivi della rete locale.
HOST=127.0.0.1
PORT=8000

# Facoltativo: certificato HTTPS (es. generato con mkcert).
# Serve per usare il microfono da un altro dispositivo. Lascia vuoto per HTTP.
SSL_KEYFILE=
SSL_CERTFILE=

# Facoltativo: cartella dove salvare chat, memoria e promemoria (default: ./data)
# DATA_DIR=
